JWT_REFRESH_EXPIRES_IN=30d
RESET_PASSWORD_EXPIRES_IN=1h
REDEMPTION_CODE_EXPIRES_HOURS=24

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo (SMTP)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
